# ============================================
# GeiIt企业知识库 - 前端 .gitignore（补充根目录规则）
# ============================================

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 依赖
node_modules/

# 构建产物
dist/
dist-ssr/

# 测试覆盖率
coverage/

# 环境变量（含密钥，禁止上传）
.env
.env.local
.env.production
.env.*.local
# 保留示例文件
!.env.example

# 临时 / 本地文件
*.local
*.tmp
*.temp

# 编辑器 / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统
.DS_Store
Thumbs.db
Desktop.ini
