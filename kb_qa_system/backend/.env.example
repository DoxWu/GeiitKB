# ============================================
# GeiIt企业知识库 - 环境变量配置示例（生产版）
# ============================================
# 使用方法：复制本文件为 .env，并填入实际值
# cp .env.example .env

# ============================================
# 应用配置
# ============================================
ENVIRONMENT=development
DEBUG=True
PORT=8000

# ============================================
# CORS 跨域配置
# ============================================
# 作用：允许前端域名跨域访问后端 API，浏览器安全策略要求后端明确允许
# 配置格式：JSON 数组字符串，多个域名用逗号分隔
# 开发环境：默认包含 localhost:3000 / localhost:5173
# 生产环境：必须改为前端实际域名（如 Railway/Vercel 域名），禁止使用通配符 *
#
# 安全要求（生产环境启动时会校验）：
#   - 禁止使用通配符 *（会允许任意域名跨域访问，存在安全风险）
#   - 必须列出精确的前端域名
#   - 协议、域名、端口必须完全匹配（https:// 与 http:// 不同）
#
# Railway 部署示例：
#   CORS_ORIGINS=["https://your-frontend.up.railway.app","https://your-custom-domain.com"]
#
# 多环境部署（同时允许预发布和生产）：
#   CORS_ORIGINS=["https://app.example.com","https://staging-app.up.railway.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ============================================
# 数据库配置（PostgreSQL）
# ============================================
# 开发环境（docker-compose）：postgresql+psycopg://postgres:postgres@localhost:5432/kb_qa
# Railway 生产环境：Railway 会自动注入 DATABASE_URL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kb_qa

# 数据库连接池
# 开发环境：建议 DB_POOL_SIZE=5, DB_MAX_OVERFLOW=5（单用户调试，减少本地 PG 占用）
# 生产环境：建议 DB_POOL_SIZE=10, DB_MAX_OVERFLOW=20（多并发访问）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ============================================
# Redis 配置
# ============================================
# 开发环境：redis://localhost:6379/0
# Railway 生产环境：Railway 会自动注入 REDIS_URL
REDIS_URL=redis://localhost:6379/0

# ============================================
# Celery 配置
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIMEOUT=600
CELERY_TASK_MAX_RETRIES=3

# ============================================
# JWT 认证配置
# ============================================
# SECRET_KEY 必须设置为随机长字符串（≥32 字符），用于 JWT 签名
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 安全要求：
#   - 开发环境：留空则自动生成临时密钥（重启后失效，需重新登录）
#   - 生产环境：必须显式设置，否则应用拒绝启动
#   - 禁止使用弱密钥（secret、changeme、123456 等）
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# 邮件 SMTP 配置（Resend）
# ============================================
# 是否启用邮件发送（开发环境关闭，仅记录日志；生产环境必须开启）
EMAIL_ENABLED=False

# Resend SMTP 配置
# 获取 API Key：https://resend.com/api-keys
# 格式：re_xxxxxxxxxxxx
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
SMTP_USE_TLS=True
SMTP_START_TLS=False
SMTP_TIMEOUT=30

# 发件人地址
# 开发环境：Resend 默认域 onboarding@resend.dev（仅可发送到管理员邮箱）
# 生产环境：改为已验证域名的邮箱，如 GeiIt企业知识库 <noreply@yourdomain.com>
EMAIL_FROM=GeiIt企业知识库 <onboarding@resend.dev>

# 管理员通知邮箱（接收注册申请通知）
ADMIN_NOTIFY_EMAIL=admin@example.com

# 前端基础 URL（用于拼接邮件中的密码设置链接）
# 开发环境：http://localhost:5173
# 生产环境：https://your-frontend-domain.com
FRONTEND_BASE_URL=http://localhost:5173

# 密码设置 Token 有效期（小时）
PASSWORD_TOKEN_EXPIRE_HOURS=24

# ============================================
# LLM 大模型配置
# ============================================
# OpenAI 官方
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-pro
LLM_FALLBACK_MODEL_NAME=deepseek-v4-flash
EMBEDDING_MODEL_NAME=text-embedding-v4
EMBEDDING_DIMENSION=1536
VISION_MODEL_NAME=qwen3.6-plus

# 如使用智谱 AI（注释掉上面的，取消注释下面的）
# OPENAI_API_KEY=your-zhipu-api-key
# OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL_NAME=glm-4
# EMBEDDING_MODEL_NAME=embedding-2

# 如使用本地 Ollama
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE=http://localhost:11434/v1
# LLM_MODEL_NAME=qwen2.5:7b
# EMBEDDING_MODEL_NAME=nomic-embed-text

# ============================================
# LLM 容错配置
# ============================================
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_TIMEOUT=60
# 推理模型（如 deepseek-v4-pro）首字延迟较长（需内部推理后才开始输出）
# 5s 超时会导致健康探测失败→熔断器打开→所有 LLM 调用被拦截
# 非推理模型（如 qwen-plus）5s 足够，推理模型建议 ≥30s
LLM_STREAM_FIRST_TOKEN_TIMEOUT=30
# Aliyun 端点存在间歇性 SSL EOF 错误，调高阈值避免误熔断（5→10）
CIRCUIT_BREAKER_THRESHOLD=10
CIRCUIT_BREAKER_RECOVERY_TIME=60

# ============================================
# 多API部署方案（可选）
# ============================================
# 作用：支持文本/向量/多模态模型及其降级模型独立配置不同 API 端点
# 配置文件：app/core/model_provider/providers.yaml
# 优先级：环境变量 > .env > YAML 默认值 > YAML 字面值
# 兼容性：不设置以下变量时，系统完全兼容现有配置（主备共用同一 API）

# 降级 LLM 独立 API 配置（不设置则复用主 API）
# 作用：主模型和降级模型可使用不同 API 提供商，避免单点故障
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_BASE=https://ws-fpzje8gjl9rtqogw.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_ENABLED=true

# 降级 Embedding 独立 API 配置
# 作用：embedding 的 cloud_fallback 端点独立配置，避免错误降级到不支持 embeddings 的 API
# 注意：DeepSeek API 不支持 /embeddings 端点，embedding 降级必须指向支持 embeddings 的 API（如阿里云）
# 不设置时 providers.yaml 会降级到 LLM_FALLBACK_API_KEY/BASE，若 LLM 降级用的是 DeepSeek 会导致 401 熔断
EMBEDDING_FALLBACK_API_KEY=
EMBEDDING_FALLBACK_API_BASE=https://ws-fpzje8gjl9rtqogw.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 本地 LLM 兜底（Ollama，默认关闭）
# 作用：远程 API 全部不可用时，使用本地模型兜底
# 安装 Ollama 后拉取模型：ollama pull qwen2.5:7b
LOCAL_LLM_ENABLED=false
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_BASE=http://localhost:11434/v1

# 本地 Embedding 兜底（HuggingFace，默认开启）
# 作用：在线 Embedding API 不可用时，使用本地模型兜底
# 首次使用会自动下载模型（约 100MB）
LOCAL_EMBEDDING_ENABLED=true

# 降级 Vision API（默认关闭）
# 作用：主多模态模型不可用时，使用降级多模态模型
VISION_FALLBACK_MODEL=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_API_BASE=
VISION_FALLBACK_ENABLED=false

# ============================================
# 向量检索配置
# ============================================
# 检索调优后的参数（与 config.py 默认值一致）
SEARCH_TOP_K=6
SIMILARITY_THRESHOLD=0.35
ENABLE_HYBRID_SEARCH=True
KEYWORD_SEARCH_WEIGHT=0.3

# ============================================
# 文档处理配置
# ============================================
# 分块参数调优：chunk_size 500→800，overlap 50→100
CHUNK_SIZE=800
CHUNK_OVERLAP=100
DOCUMENT_QUALITY_THRESHOLD=60.0
ENABLE_OCR=True
ENABLE_VISION=True
ENABLE_TABLE_EXTRACTION=True

# ============================================
# 记忆衰退配置
# ============================================
CONVERSATION_HISTORY_LIMIT=5
CONVERSATION_HISTORY_MAX_TOKENS=2000
ENABLE_HISTORY_SUMMARY=True
SUMMARY_EVERY_N_TURNS=5

# ============================================
# 限流配置
# ============================================
ENABLE_RATE_LIMIT=True
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ASK_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=20
LOGIN_FAILURE_LOCK_THRESHOLD=5
LOGIN_FAILURE_LOCK_MINUTES=15

# ============================================
# 缓存配置
# ============================================
ENABLE_FAQ_CACHE=True
FAQ_CACHE_SIMILARITY_THRESHOLD=0.95
FAQ_CACHE_TTL=604800

# ============================================
# 监控配置（可选）
# ============================================
ENABLE_SENTRY=False
SENTRY_DSN=

# ============================================
# Prometheus 监控配置
# ============================================
# 作用：控制 /metrics 端点行为和指标采集策略
# 启用方式：设为 true 后访问 http://localhost:8000/metrics
# 生产环境建议开启 Basic Auth 保护端点
# L-12 修复：ENABLE_PROMETHEUS 从上方"监控配置"区移至此处，与其他 PROMETHEUS_ 变量统一管理
ENABLE_PROMETHEUS=False
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_AUTH_ENABLED=False
PROMETHEUS_AUTH_USER=prometheus
PROMETHEUS_AUTH_PASSWORD=
# 是否在 http_requests_total 中包含路径标签
# true：按端点路径维度切分（开发环境便于排查）
# false：返回 unlabeled，避免高基数导致 Prometheus 内存爆炸（生产环境推荐）
PROMETHEUS_INCLUDE_PATH_LABEL=True

# 第四阶段 RAG 优化功能开关
# 意图识别：闲聊/追问/元问题走无检索路径，避免误拦截
ENABLE_INTENT_DETECTION=True
# 矛盾检测：检索结果冲突时标记
ENABLE_CONFLICT_DETECTION=True
# LaTeX 公式保护：分块时不破坏 $...$ 公式
ENABLE_LATEX_PROTECTION=True

REQUEST_LOG_SAMPLE_RATE=1.0

# ============================================
# 性能调优配置
# ============================================
# 模型健康检查启动模式
# False（默认）：非阻塞，健康检查后台异步启动，应用立即就绪（生产推荐）
# True：阻塞，等待健康检查 Task 创建后再就绪（调试用）
MODEL_EAGER_HEALTH_CHECK=False

# ============================================
# 超级管理员初始化（仅部署时使用，非运行时配置）
# ============================================
# 作用：部署后通过 python -m scripts.create_superuser 创建超级管理员
# 使用方式：
#   1. 设置以下三个变量
#   2. 执行：python -m scripts.create_superuser
#   3. 创建完成后删除 SUPERUSER_PASSWORD（避免密码暴露）
#
# 安全要求：
#   - 密码 ≥8 字符，必须包含字母和数字
#   - 创建后立即删除这些变量，不要长期保留在配置中
# SUPERUSER_USERNAME=admin
# SUPERUSER_EMAIL=admin@example.com
# SUPERUSER_PASSWORD=Secure123
