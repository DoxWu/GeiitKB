# ============================================
# GeiIt企业知识库 - 环境变量配置示例（生产版）
# ============================================
# 使用方法：复制本文件为 .env，并填入实际值
# cp .env.example .env

# ============================================
# 应用配置
# ============================================
ENVIRONMENT=development
DEBUG=True
PORT=8000

# ============================================
# CORS 跨域配置
# ============================================
# 作用：允许前端域名跨域访问后端 API，浏览器安全策略要求后端明确允许
# 配置格式：JSON 数组字符串，多个域名用逗号分隔
# 开发环境：默认包含 localhost:3000 / localhost:5173
# 生产环境：必须改为前端实际域名（如 Railway/Vercel 域名），禁止使用通配符 *
#
# 安全要求（生产环境启动时会校验）：
#   - 禁止使用通配符 *（会允许任意域名跨域访问，存在安全风险）
#   - 必须列出精确的前端域名
#   - 协议、域名、端口必须完全匹配（https:// 与 http:// 不同）
#
# Railway 部署示例：
#   CORS_ORIGINS=["https://your-frontend.up.railway.app","https://your-custom-domain.com"]
#
# 多环境部署（同时允许预发布和生产）：
#   CORS_ORIGINS=["https://app.example.com","https://staging-app.up.railway.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ============================================
# 数据库配置（PostgreSQL）
# ============================================
# 开发环境（docker-compose）：postgresql+psycopg://postgres:postgres@localhost:5432/kb_qa
# Railway 生产环境：Railway 会自动注入 DATABASE_URL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kb_qa

# 数据库连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ============================================
# Redis 配置
# ============================================
# 开发环境：redis://localhost:6379/0
# Railway 生产环境：Railway 会自动注入 REDIS_URL
REDIS_URL=redis://localhost:6379/0

# ============================================
# Celery 配置
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIMEOUT=600
CELERY_TASK_MAX_RETRIES=3

# ============================================
# JWT 认证配置
# ============================================
# SECRET_KEY 必须设置为随机长字符串（≥32 字符），用于 JWT 签名
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 安全要求：
#   - 开发环境：留空则自动生成临时密钥（重启后失效，需重新登录）
#   - 生产环境：必须显式设置，否则应用拒绝启动
#   - 禁止使用弱密钥（secret、changeme、123456 等）
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# LLM 大模型配置
# ============================================
# OpenAI 官方
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-3.5-turbo
LLM_FALLBACK_MODEL_NAME=gpt-3.5-turbo
EMBEDDING_MODEL_NAME=text-embedding-ada-002
EMBEDDING_DIMENSION=1536
VISION_MODEL_NAME=gpt-4o-mini

# 如使用智谱 AI（注释掉上面的，取消注释下面的）
# OPENAI_API_KEY=your-zhipu-api-key
# OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL_NAME=glm-4
# EMBEDDING_MODEL_NAME=embedding-2

# 如使用本地 Ollama
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE=http://localhost:11434/v1
# LLM_MODEL_NAME=qwen2.5:7b
# EMBEDDING_MODEL_NAME=nomic-embed-text

# ============================================
# LLM 容错配置
# ============================================
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_TIMEOUT=30
LLM_STREAM_FIRST_TOKEN_TIMEOUT=5
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME=60

# ============================================
# 向量检索配置
# ============================================
SEARCH_TOP_K=4
SIMILARITY_THRESHOLD=0.5
ENABLE_HYBRID_SEARCH=True
KEYWORD_SEARCH_WEIGHT=0.3

# ============================================
# 文档处理配置
# ============================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DOCUMENT_QUALITY_THRESHOLD=60.0
ENABLE_OCR=True
ENABLE_VISION=True
ENABLE_TABLE_EXTRACTION=True

# ============================================
# 记忆衰退配置
# ============================================
CONVERSATION_HISTORY_LIMIT=5
CONVERSATION_HISTORY_MAX_TOKENS=2000
ENABLE_HISTORY_SUMMARY=True
SUMMARY_EVERY_N_TURNS=5

# ============================================
# 限流配置
# ============================================
ENABLE_RATE_LIMIT=True
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ASK_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_HOUR=20
LOGIN_FAILURE_LOCK_THRESHOLD=5
LOGIN_FAILURE_LOCK_MINUTES=15

# ============================================
# 缓存配置
# ============================================
ENABLE_FAQ_CACHE=True
FAQ_CACHE_SIMILARITY_THRESHOLD=0.95
FAQ_CACHE_TTL=604800

# ============================================
# 监控配置（可选）
# ============================================
ENABLE_SENTRY=False
SENTRY_DSN=

# ============================================
# Prometheus 监控配置
# ============================================
# 作用：控制 /metrics 端点行为和指标采集策略
# 启用方式：设为 true 后访问 http://localhost:8000/metrics
# 生产环境建议开启 Basic Auth 保护端点
# L-12 修复：ENABLE_PROMETHEUS 从上方"监控配置"区移至此处，与其他 PROMETHEUS_ 变量统一管理
ENABLE_PROMETHEUS=False
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_AUTH_ENABLED=False
PROMETHEUS_AUTH_USER=prometheus
PROMETHEUS_AUTH_PASSWORD=
# 是否在 http_requests_total 中包含路径标签
# true：按端点路径维度切分（开发环境便于排查）
# false：返回 unlabeled，避免高基数导致 Prometheus 内存爆炸（生产环境推荐）
PROMETHEUS_INCLUDE_PATH_LABEL=True

# 第四阶段 RAG 优化功能开关
# 意图识别：闲聊/追问/元问题走无检索路径，避免误拦截
ENABLE_INTENT_DETECTION=True
# 矛盾检测：检索结果冲突时标记
ENABLE_CONFLICT_DETECTION=True
# LaTeX 公式保护：分块时不破坏 $...$ 公式
ENABLE_LATEX_PROTECTION=True

REQUEST_LOG_SAMPLE_RATE=1.0
